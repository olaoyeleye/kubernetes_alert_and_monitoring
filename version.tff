 

# ========================================
# Data Sources
# ========================================
data "aws_availability_zones" "available" {
  state = "available"
}

# ========================================
# VPC Module
# ========================================
module "vpc" {
  source  = "terraform-aws-modules/vpc/aws"
  version = "5.0.0"

  name = "monitoring-vpc"
  cidr = "10.10.0.0/16"

  azs             = slice(data.aws_availability_zones.available.names, 0, var.az_count)
  public_subnets  = [for i in range(var.az_count) : cidrsubnet("10.10.0.0/16", 8, i + 128)]
  private_subnets = [for i in range(var.az_count) : cidrsubnet("10.10.0.0/16", 8, i + 1)]

  enable_nat_gateway      = true
  single_nat_gateway      = false
  map_public_ip_on_launch = true
  
  # Enable DNS for EKS
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Environment                                   = "monitoring"
    ManagedBy                                     = "terraform"
    "kubernetes.io/cluster/${var.cluster_name}"  = "shared"
  }

  public_subnet_tags = {
    "kubernetes.io/role/elb" = "1"
  }

  private_subnet_tags = {
    "kubernetes.io/role/internal-elb" = "1"
  }
}

# ========================================
# Security Groups
# ========================================
resource "aws_security_group" "monitor_sg" {
  name        = "monitoring-external-access-sg"
  description = "Allow external access to monitoring services"
  vpc_id      = module.vpc.vpc_id

  ingress {
    description = "Grafana"
    from_port   = 3000
    to_port     = 3000
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }

  ingress {
    description = "Prometheus"
    from_port   = 9090
    to_port     = 9090
    protocol    = "tcp"
    cidr_blocks = [var.allowed_cidr]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name        = "monitoring-external-access-sg"
    Environment = "monitoring"
  }
}

# ========================================
# EKS Cluster
# ========================================
module "eks" {
  source  = "terraform-aws-modules/eks/aws"
  version = "20.31.0"
  
  cluster_name    = var.cluster_name
  cluster_version = "1.29"

  vpc_id     = module.vpc.vpc_id
  subnet_ids = module.vpc.private_subnets
  
  # Control plane endpoint configuration
  cluster_endpoint_public_access  = true
  cluster_endpoint_private_access = true

  # Simplified access control
  enable_cluster_creator_admin_permissions = true

  # Enable IRSA
  enable_irsa = true

  # Cluster addons
  cluster_addons = {
    coredns = {
      most_recent = true
    }
    kube-proxy = {
      most_recent = true
    }
    vpc-cni = {
      most_recent = true
    }
    aws-ebs-csi-driver = {
      most_recent              = true
      service_account_role_arn = module.ebs_csi_irsa_role.iam_role_arn
    }
  }

  # EKS Managed Node Groups
  eks_managed_node_groups = {
    managed_nodes = {
      name = "monitoring-node-group"
      
      instance_types = ["t3.medium"]
      capacity_type  = "ON_DEMAND"
      
      min_size     = 1
      max_size     = 4
      desired_size = 2
      
      # Use default launch template
      use_custom_launch_template = false
      
      # Disk configuration
      disk_size = 50
      
      # IAM configuration
      iam_role_attach_cni_policy = true
      
      # Network configuration
      subnet_ids = module.vpc.private_subnets
      
      # Tags
      labels = {
        Environment = "monitoring"
        NodeGroup   = "managed-nodes"
      }
      
      tags = {
        Name        = "monitoring-node"
        Environment = "monitoring"
      }
      
      # Update configuration
      update_config = {
        max_unavailable_percentage = 33
      }
    }
  }

  # Security group rules for monitoring tools
  node_security_group_additional_rules = {
    # Allow nodes to communicate with each other
    ingress_self_all = {
      description = "Node to node all traffic"
      protocol    = "-1"
      from_port   = 0
      to_port     = 0
      type        = "ingress"
      self        = true
    }
    
    # Allow cluster control plane to communicate with nodes
    ingress_cluster_all = {
      description                   = "Cluster to node all traffic"
      protocol                      = "-1"
      from_port                     = 0
      to_port                       = 0
      type                          = "ingress"
      source_cluster_security_group = true
    }
    
    # Allow all outbound traffic
    egress_all = {
      description = "Node all egress"
      protocol    = "-1"
      from_port   = 0
      to_port     = 0
      type        = "egress"
      cidr_blocks = ["0.0.0.0/0"]
    }
    
    # Allow Prometheus scraping within VPC
    ingress_prometheus = {
      description = "Allow Prometheus scraping"
      protocol    = "tcp"
      from_port   = 9090
      to_port     = 9090
      type        = "ingress"
      cidr_blocks = [module.vpc.vpc_cidr_block]
    }
    
    # Allow Node Exporter within VPC
    ingress_node_exporter = {
      description = "Allow Node Exporter"
      protocol    = "tcp"
      from_port   = 9100
      to_port     = 9100
      type        = "ingress"
      cidr_blocks = [module.vpc.vpc_cidr_block]
    }
    
    # Allow cAdvisor within VPC
    ingress_cadvisor = {
      description = "Allow cAdvisor"
      protocol    = "tcp"
      from_port   = 8080
      to_port     = 8080
      type        = "ingress"
      cidr_blocks = [module.vpc.vpc_cidr_block]
    }
    
    # Allow Grafana within VPC
    ingress_grafana = {
      description = "Allow Grafana"
      protocol    = "tcp"
      from_port   = 3000
      to_port     = 3000
      type        = "ingress"
      cidr_blocks = [module.vpc.vpc_cidr_block]
    }
    
    # Allow AlertManager within VPC
    ingress_alertmanager = {
      description = "Allow AlertManager"
      protocol    = "tcp"
      from_port   = 9093
      to_port     = 9093
      type        = "ingress"
      cidr_blocks = [module.vpc.vpc_cidr_block]
    }
  }

  tags = {
    Environment = "monitoring"
    ManagedBy   = "terraform"
  }
}

# ========================================
# IAM Role for EBS CSI Driver
# ========================================
module "ebs_csi_irsa_role" {
  source  = "terraform-aws-modules/iam/aws//modules/iam-role-for-service-accounts-eks"
  version = "~> 5.0"

  role_name = "${var.cluster_name}-ebs-csi-driver"

  attach_ebs_csi_policy = true

  oidc_providers = {
    main = {
      provider_arn               = module.eks.oidc_provider_arn
      namespace_service_accounts = ["kube-system:ebs-csi-controller-sa"]
    }
  }

  tags = {
    Environment = "monitoring"
    ManagedBy   = "terraform"
  }
}

# ========================================
# Helm Module (Deploy Monitoring Stack)
# ========================================
module "helm" {
  source = "./helm"

  cluster_name = module.eks.cluster_name
  region       = var.region

  providers = {
    kubernetes = kubernetes
    helm       = helm
  }

  depends_on = [
    module.eks,
    module.ebs_csi_irsa_role
  ]
}