output "cluster_endpoint" {
  description = "EKS cluster endpoint"
  value       = module.eks.cluster_endpoint
}

output "cluster_name" {
  description = "EKS cluster name"
  value       = module.eks.cluster_name
}

output "cluster_certificate_authority_data" {
  description = "Base64 encoded certificate data"
  value       = module.eks.cluster_certificate_authority_data
  sensitive   = true
}

output "cluster_id" {
  description = "EKS cluster ID"
  value       = module.eks.cluster_id
}

output "cluster_security_group_id" {
  description = "Security group ID attached to the EKS cluster"
  value       = module.eks.cluster_security_group_id
}

output "node_security_group_id" {
  description = "Security group ID attached to the EKS nodes"
  value       = module.eks.node_security_group_id
}


# ========================================
# Configuration Commands
# ========================================
output "configure_kubectl" {
  description = "Command to configure kubectl"
  value       = "aws eks update-kubeconfig --region ${var.region} --name ${module.eks.cluster_name}"
}

output "test_cluster_access" {
  description = "Commands to test cluster access"
  value = <<-EOT
    # Configure kubectl
    aws eks update-kubeconfig --region ${var.region} --name ${module.eks.cluster_name}
    
    # Verify nodes
    kubectl get nodes
    
    # Check system pods
    kubectl get pods -n kube-system
    
    # Get cluster info
    kubectl cluster-info
  EOT
}

# ========================================
# Monitoring Access
# ========================================
output "monitoring_security_group_id" {
  description = "Security group ID for external monitoring access"
  value       = aws_security_group.monitor_sg.id
}

output "grafana_access_info" {
  description = "Information to access Grafana after Helm deployment"
  value = <<-EOT
    Once Helm monitoring stack is deployed, access Grafana with:
    
    kubectl port-forward -n monitoring svc/grafana 3000:80
    
    Then open: http://localhost:3000
    Default credentials: admin / <check grafana secret>
  EOT
}